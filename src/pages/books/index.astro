---
// Transcribed from the hand-written page by scripts/convert_page.py.
// Body is verbatim; head values come from the original tags.
import Base from "../../layouts/Base.astro";
import BookCard from "../../components/BookCard.astro";
import bookData from "../../data/books.json";
import { ORDER, COPY } from "../../data/copy";
const books = bookData.books;
const num = (s) => {
  const b = books.find((x) => x.slug === s);
  const n = String(ORDER.indexOf(s) + 1).padStart(2, "0");
  const label = b.series
    ? `<a href="/books/${b.series.slug}/">${b.series.name}</a>, Book ${b.series.position}`
    : COPY[s].indexLabel;
  return `\u2116 ${n} \u00b7 ${label}`;
};
const SITE = "https://inknironapps.com";
const listing = ORDER.map((slug, i) => ({ slug, book: books.find((b) => b.slug === slug), i }));
/** Generated, so numberOfItems and every datePublished follow the data.
 *  Hand-maintained, this block carried a publication date that stayed
 *  wrong after the same date was corrected on the detail page. */
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Books by Riley E. Antrobus",
  url: `${SITE}/books/`,
  numberOfItems: listing.length,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: listing.map(({ slug, book, i }) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${SITE}${book.path}`,
    item: {
      "@type": "Book",
      name: book.title,
      url: `${SITE}${book.path}`,
      image: `${SITE}${book.image}`,
      author: { "@type": "Person", name: "Riley E. Antrobus" },
      datePublished: new Date(`${COPY[slug].published} UTC`).toISOString().slice(0, 10),
      ...(book.series
        ? { isPartOf: { "@type": "BookSeries", name: book.series.name,
                        url: `${SITE}/books/${book.series.slug}/` } }
        : {}),
    },
  })),
};
const head = {
  "title": "Books — Riley E. Antrobus",
  "description": "The full library of books by Riley E. Antrobus — speculative fiction, short stories, and series.",
  "keywords": "Riley E. Antrobus books, Warborn Protocols, Fleet School Dropout, Network Recruit, Echoes of Yggdrasil, The Nine Bridges, The Recursion Engine, The Weaving of Eternal Tapestry, science fiction novels, urban fantasy, speculative fiction",
  "path": "/books/",
  "ogType": "website",
  "ogSiteName": "Riley E. Antrobus",
  "ogTitle": "Books — Riley E. Antrobus",
  "ogDescription": "The full library of books by Riley E. Antrobus.",
  "image": "/og-image-1200x630.png",
  "imageWidth": 1200,
  "imageHeight": 630,
  "jsonld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://inknironapps.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Books",
          "item": "https://inknironapps.com/books/"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Books by Riley E. Antrobus",
      "url": "https://inknironapps.com/books/",
      "author": {
        "@type": "Person",
        "name": "Riley E. Antrobus",
        "url": "https://inknironapps.com/"
      },
      "hasPart": [
        {
          "@type": "Book",
          "name": "Fleet School Dropout",
          "url": "https://inknironapps.com/books/warborn-protocols/fleet-school-dropout.html",
          "author": {
            "@type": "Person",
            "name": "Riley E. Antrobus"
          }
        },
        {
          "@type": "Book",
          "name": "Network Recruit",
          "url": "https://inknironapps.com/books/warborn-protocols/network-recruit.html",
          "author": {
            "@type": "Person",
            "name": "Riley E. Antrobus"
          }
        },
        {
          "@type": "Book",
          "name": "The Nine Bridges",
          "url": "https://inknironapps.com/books/echoes-of-yggdrasil/the-nine-bridges.html",
          "author": {
            "@type": "Person",
            "name": "Riley E. Antrobus"
          }
        },
        {
          "@type": "Book",
          "name": "The Recursion Engine",
          "url": "https://inknironapps.com/books/the-recursion-engine.html",
          "author": {
            "@type": "Person",
            "name": "Riley E. Antrobus"
          }
        },
        {
          "@type": "Book",
          "name": "The Weaving of Eternal Tapestry",
          "url": "https://inknironapps.com/books/weaving-eternal-tapestry.html",
          "author": {
            "@type": "Person",
            "name": "Riley E. Antrobus"
          }
        }
      ]
    },
    itemList
  ]
};
---
<Base {...head}>
<section class="books-index">
  <a class="back-link" href="/">&larr; Home</a>
  <div class="kicker">The Library</div>
  <h2>Books, <em>by Riley E. Antrobus</em>.</h2>
  <p class="lede">Speculative fiction — military-edge science fiction, creation myth, and the worlds in between.</p>

    <BookCard slug="fleet-school-dropout" num={num("fleet-school-dropout")} />

    <BookCard slug="network-recruit" num={num("network-recruit")} />

    <BookCard slug="the-nine-bridges" num={num("the-nine-bridges")} />

    <BookCard slug="the-recursion-engine" num={num("the-recursion-engine")} />

    <BookCard slug="weaving-eternal-tapestry" num={num("weaving-eternal-tapestry")} />
</section>
</Base>
