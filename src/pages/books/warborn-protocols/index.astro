---
// Transcribed from the hand-written page by scripts/convert_page.py.
// Body is verbatim; head values come from the original tags.
import Base from "../../../layouts/Base.astro";
import BookCard from "../../../components/BookCard.astro";
import bookData from "../../../data/books.json";
import { SERIES } from "../../../data/copy";
const books = bookData.books;
const num = (s) => `Book ${books.find(b => b.slug === s).series.position}`;
const SITE = "https://inknironapps.com";
const cfg = SERIES["warborn-protocols"];
/** Generated so hasPart follows the data. Hand-maintained, this block had an
 *  image on two of three books and not the third. Live books come from
 *  books.json in series order; cfg.announced picks which forthcoming titles
 *  the site advertises. */
const seriesBooks = books
  .filter((b) => b.series?.slug === "warborn-protocols" && b.status === "live")
  .sort((a, b) => a.series.position - b.series.position)
  .map((b) => ({
    "@type": "Book",
    name: b.title,
    url: `${SITE}${b.path}`,
    image: `${SITE}${b.image}`,
    position: b.series.position,
  }));
const forthcoming = cfg.announced.map((slug) => {
  const b = books.find((x) => x.slug === slug);
  if (!b) throw new Error(`Announced book "${slug}" is not in books.json`);
  return { "@type": "Book", name: b.title, position: b.series.position, bookEdition: "Forthcoming" };
});
const bookSeries = {
  "@context": "https://schema.org",
  "@type": "BookSeries",
  name: "Warborn Protocols",
  url: `${SITE}/books/warborn-protocols/`,
  author: { "@type": "Person", name: "Riley E. Antrobus", url: `${SITE}/` },
  genre: cfg.genre,
  hasPart: [...seriesBooks, ...forthcoming].sort((a, b) => a.position - b.position),
};
const head = {
  "title": "Warborn Protocols — Riley E. Antrobus",
  "description": "Warborn Protocols — a military-edge science fiction series by Riley E. Antrobus. Reading order, lore, and editions.",
  "keywords": "Warborn Protocols, Warborn Protocols series, Riley E. Antrobus, military science fiction, space opera, Fleet School Dropout",
  "path": "/books/warborn-protocols/",
  "ogType": "website",
  "ogSiteName": "Riley E. Antrobus",
  "ogTitle": "Warborn Protocols — Riley E. Antrobus",
  "ogDescription": "A military-edge science fiction series.",
  "image": "/og-image-1200x630.png",
  "imageWidth": 1200,
  "imageHeight": 630,
  "jsonld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://inknironapps.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Books",
          "item": "https://inknironapps.com/books/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Warborn Protocols",
          "item": "https://inknironapps.com/books/warborn-protocols/"
        }
      ]
    },
    bookSeries
  ]
};
---
<Base {...head}>
<section class="books-index">
  <a class="back-link" href="/books/">&larr; All books</a>
  <div class="kicker">Series · Warborn Protocols</div>
  <h2>Warborn <em>Protocols</em>.</h2>
  <p class="lede">Military-edge science fiction. Expelled cadets, rogue war AIs, and the bones of a war the Republic thought it buried. A three-book arc concluding with <em>Otherwhere Witness</em> — read in publication order.</p>

    <BookCard slug="fleet-school-dropout" num={num("fleet-school-dropout")} />

    <BookCard slug="network-recruit" num={num("network-recruit")} />

  <article class="book-card">
    <a class="book-card-cover" href="/contact.html?topic=author" style="background:rgba(9,95,115,0.12);border:1px solid rgba(232,228,218,0.08);aspect-ratio:2/3;display:flex;align-items:center;justify-content:center;">
      <span style="font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.25em;text-transform:uppercase;color:var(--teal-bright);">Cover coming soon</span>
    </a>
    <div class="book-card-body">
      <span class="num">Book 3 · Coming soon</span>
      <h3>Otherwhere Witness</h3>
      <p class="tagline"><em>The finale of the Warborn Protocols trilogy.</em></p>
      <p>Warborn Protocols Book 3 — the final chapter of Riko Vega's story. In the forge; release date and full details land here as soon as they're ready.</p>
      <div class="editions">
        <a class="edition-btn ghost" href="/contact.html?topic=author">Notify me &rsaquo;</a>
      </div>
    </div>
  </article>

  <div class="section-foot">
    <p class="lede" style="text-align:center;opacity:.7">Want a heads-up when Otherwhere Witness drops? <a href="/contact.html?topic=author">Drop your email on the contact form</a>.</p>
  </div>
</section>
</Base>
