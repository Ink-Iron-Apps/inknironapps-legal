---
// Transcribed from the hand-written page by scripts/convert_page.py.
// Body is verbatim; head values come from the original tags.
import Base from "../../../layouts/Base.astro";
import BookCard from "../../../components/BookCard.astro";
import bookData from "../../../data/books.json";
const books = bookData.books;
const num = (s) => `Book ${books.find(b => b.slug === s).series.position}`;
const head = {
  "title": "Echoes of Yggdrasil — Riley E. Antrobus",
  "description": "Echoes of Yggdrasil — a Norse-mythology urban fantasy series by Riley E. Antrobus. A hidden world beneath Chicago, rune magic, and the bridges that hold the world together. Reading order and editions.",
  "keywords": "Echoes of Yggdrasil, Echoes of Yggdrasil series, Riley E. Antrobus, Norse mythology urban fantasy, rune magic young adult fantasy, The Nine Bridges, Chicago contemporary fantasy",
  "path": "/books/echoes-of-yggdrasil/",
  "ogType": "website",
  "ogSiteName": "Riley E. Antrobus",
  "ogTitle": "Echoes of Yggdrasil — Riley E. Antrobus",
  "ogDescription": "A Norse-mythology urban fantasy series — a hidden world beneath Chicago, rune magic, and the bridges that hold the world together.",
  "image": "/og-image-1200x630.png",
  "twitterDescription": "A Norse-mythology urban fantasy series by Riley E. Antrobus.",
  "imageWidth": 1200,
  "imageHeight": 630,
  "jsonld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://inknironapps.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Books",
          "item": "https://inknironapps.com/books/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Echoes of Yggdrasil",
          "item": "https://inknironapps.com/books/echoes-of-yggdrasil/"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "BookSeries",
      "name": "Echoes of Yggdrasil",
      "url": "https://inknironapps.com/books/echoes-of-yggdrasil/",
      "author": {
        "@type": "Person",
        "name": "Riley E. Antrobus",
        "url": "https://inknironapps.com/"
      },
      "genre": [
        "Young Adult Fiction",
        "Fantasy",
        "Urban Fantasy",
        "Norse Mythology"
      ],
      "hasPart": [
        {
          "@type": "Book",
          "name": "The Nine Bridges",
          "url": "https://inknironapps.com/books/echoes-of-yggdrasil/the-nine-bridges.html",
          "image": "https://inknironapps.com/images/books/the-nine-bridges.jpg",
          "position": 1
        },
        {
          "@type": "Book",
          "name": "The Draugr Pact",
          "position": 2,
          "bookEdition": "Forthcoming"
        }
      ]
    }
  ]
};
---
<Base {...head}>
<section class="books-index">
  <a class="back-link" href="/books/">&larr; All books</a>
  <div class="kicker">Series · Echoes of Yggdrasil</div>
  <h2>Echoes of <em>Yggdrasil</em>.</h2>
  <p class="lede">Norse-mythology urban fantasy. A hidden world beneath Chicago — dwarven smiths, wight-brokers, rune-carved tunnels, and the nine bridges that hold the world together. A six-book arc; read in order.</p>

    <BookCard slug="the-nine-bridges" num={num("the-nine-bridges")} />

  <article class="book-card">
    <a class="book-card-cover" href="/contact.html?topic=author" style="background:rgba(9,95,115,0.12);border:1px solid rgba(232,228,218,0.08);aspect-ratio:2/3;display:flex;align-items:center;justify-content:center;">
      <span style="font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.25em;text-transform:uppercase;color:var(--teal-bright);">Cover coming soon</span>
    </a>
    <div class="book-card-body">
      <span class="num">Book 2 · Coming soon</span>
      <h3>The Draugr Pact</h3>
      <p class="tagline"><em>The next descent into the Underhall.</em></p>
      <p>Echoes of Yggdrasil Book 2. In the forge — release date and full details land here as soon as they're ready.</p>
      <div class="editions">
        <a class="edition-btn ghost" href="/contact.html?topic=author">Notify me &rsaquo;</a>
      </div>
    </div>
  </article>

  <div class="section-foot">
    <p class="lede" style="text-align:center;opacity:.7">Want a heads-up when Book 2 drops? <a href="/contact.html?topic=author">Drop your email on the contact form</a>.</p>
  </div>
</section>
</Base>
