---
// Transcribed from the hand-written page by scripts/convert_page.py.
// Body is verbatim; head values come from the original tags.
import Base from "../layouts/Base.astro";
import BookCard from "../components/BookCard.astro";
import bookData from "../data/books.json";
import { ORDER, COPY } from "../data/copy";
const books = bookData.books;
const num = (s) => {
  const b = books.find((x) => x.slug === s);
  const n = String(ORDER.indexOf(s) + 1).padStart(2, "0");
  const label = b.series
    ? `<a href="/books/${b.series.slug}/">${b.series.name}</a>, Book ${b.series.position}`
    : COPY[s].indexLabel;
  return `\u2116 ${n} \u00b7 ${label}`;
};
const head = {
  "title": "Riley E. Antrobus — Crafted Stories. Forged Software.",
  "description": "Riley E. Antrobus — author of speculative fiction and creator of Ink & Iron Apps. Books, apps, and the workshop behind both.",
  "keywords": "Riley E. Antrobus, Warborn Protocols, Fleet School Dropout, Network Recruit, Echoes of Yggdrasil, The Nine Bridges, The Recursion Engine, The Weaving of Eternal Tapestry, science fiction author, urban fantasy, speculative fiction, Ink and Iron Apps, indie author, Android apps, LibraryIQ reading tracker",
  "path": "/",
  "ogType": "website",
  "ogSiteName": "Riley E. Antrobus",
  "ogTitle": "Riley E. Antrobus — Crafted Stories. Forged Software.",
  "ogDescription": "Books, apps, and the workshop behind both.",
  "image": "/og-image-1200x630.png",
  "imageWidth": 1200,
  "imageHeight": 630,
  "jsonld": [
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://inknironapps.com/#riley",
          "name": "Riley E. Antrobus",
          "url": "https://inknironapps.com/",
          "email": "riley@inknironapps.com",
          "jobTitle": "Author and Software Developer",
          "description": "Author of speculative fiction and creator of Ink & Iron Apps.",
          "sameAs": [
            "https://www.facebook.com/people/Riley-E-Antrobus/61580037872318/",
            "https://www.goodreads.com/author/show/58136422.Riley_E_Antrobus",
            "https://www.amazon.com/author/rileyeantrobus"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://inknironapps.com/#website",
          "url": "https://inknironapps.com/",
          "name": "Riley E. Antrobus",
          "description": "Crafted Stories. Forged Software.",
          "publisher": {
            "@id": "https://inknironapps.com/#riley"
          },
          "inLanguage": "en-US"
        },
        {
          "@type": "Organization",
          "@id": "https://inknironapps.com/#org",
          "name": "Ink & Iron Apps",
          "alternateName": "Ink and Iron Apps",
          "url": "https://inknironapps.com/",
          "email": "info@inknironapps.com",
          "logo": "https://inknironapps.com/icon.svg",
          "image": "https://inknironapps.com/og-image-1200x630.png",
          "slogan": "Crafted stories. Forged software.",
          "founder": {
            "@id": "https://inknironapps.com/#riley"
          },
          "founders": [
            {
              "@id": "https://inknironapps.com/#riley"
            }
          ],
          "knowsAbout": [
            "Android app development",
            "Offline-first mobile apps",
            "Personal library management",
            "Landscape material estimation",
            "Recipe management",
            "Privacy-first software"
          ],
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "contactType": "customer support",
              "email": "support@inknironapps.com",
              "availableLanguage": "English"
            },
            {
              "@type": "ContactPoint",
              "contactType": "privacy",
              "email": "privacy@inknironapps.com",
              "availableLanguage": "English"
            },
            {
              "@type": "ContactPoint",
              "contactType": "security",
              "email": "security@inknironapps.com",
              "availableLanguage": "English"
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://inknironapps.com/"
            }
          ]
        }
      ]
    }
  ]
};
---
<Base {...head}>
<header class="hero">
  <svg class="hero-mark" viewBox="0 0 512 512">
    <circle cx="216" cy="256" r="124" fill="none" stroke="#E8E4DA" stroke-width="2" opacity="0.55"/>
    <circle cx="296" cy="256" r="124" fill="#095F73" opacity="0.5"/>
    <text x="256" y="330" font-family="EB Garamond,Georgia,serif" font-weight="500" font-size="170" fill="#E8E4DA" text-anchor="middle" letter-spacing="-2">I<tspan font-style="italic" fill="#3BB3C9" dx="2">&amp;</tspan><tspan dx="2">I</tspan></text>
  </svg>
  <div class="eyebrow">Riley E. Antrobus · Author &amp; Maker</div>
  <h1>Crafted Stories.<br><span class="amp">&amp;</span> Forged Software.</h1>
  <div class="rule"></div>
  <p class="tag">Two crafts, one workshop. Explore the worlds I write and the tools I build.</p>
  <div class="cta">
    <a class="btn btn-p" href="#books">Read the Books</a>
    <a class="btn btn-s" href="#apps">Use the Apps</a>
  </div>
</header>

<section id="books">
  <div class="kicker">№ 01 · The Library</div>
  <h2>Books, <em>by Riley E. Antrobus</em>.</h2>
  <p class="lede">Speculative fiction — military-edge science fiction, creation myth, and the worlds in between. Editions sold through Amazon KDP.</p>

    <BookCard slug="fleet-school-dropout" num={num("fleet-school-dropout")} variant="home" />

    <BookCard slug="network-recruit" num={num("network-recruit")} variant="home" />

    <BookCard slug="the-nine-bridges" num={num("the-nine-bridges")} variant="home" />

    <BookCard slug="the-recursion-engine" num={num("the-recursion-engine")} variant="home" />

    <BookCard slug="weaving-eternal-tapestry" num={num("weaving-eternal-tapestry")} variant="home" />

  <div class="section-foot">
    <a class="link-arrow" href="/books/">All books &rsaquo;</a>
  </div>
</section>

<section id="apps">
  <div class="kicker">№ 02 · The Workshop</div>
  <h2>Apps, <em>by Ink <span class="amp">&amp;</span> Iron Apps</em>.</h2>
  <p class="lede">Small, sharp tools for makers, readers, and small operations. <strong>LibraryIQ</strong> is live as a web app you can open right now; MatCalc and Simmer are still in <strong>closed alpha testing</strong> on Android.</p>

  <article class="app-card">
    <div class="app-card-icon">
      <img src="/images/apps/libraryiq.png" width="512" height="512" loading="lazy" decoding="async" alt="LibraryIQ app icon — reading tracker and library web app">
    </div>
    <div class="app-card-body">
      <span class="num">Live · Web app</span>
      <h3><a href="/apps/libraryiq.html">LibraryIQ</a></h3>
      <p class="tagline"><em>Your complete reading tracker — shelf, gallery, tracker, wishlist and book budget in one place.</em></p>
      <p>Live now as a web app at <strong>libraryiq.inknironapps.com</strong> — nothing to install. Scan a barcode in the browser, pull metadata from six catalogues, photograph a whole shelf, and track reading, lending, badges and book spending. Free, syncs to every device, installs to a home screen.</p>
      <div class="editions">
        <a class="edition-btn primary" href="https://libraryiq.inknironapps.com" rel="noopener">Open LibraryIQ &rarr;</a>
        <a class="edition-btn ghost" href="/apps/libraryiq.html">Details &rsaquo;</a>
      </div>
    </div>
  </article>

  <article class="app-card">
    <div class="app-card-icon">
      <img src="/images/apps/matcalc.png" width="512" height="512" loading="lazy" decoding="async" alt="MatCalc app icon — material calculator for landscapers and contractors">
    </div>
    <div class="app-card-body">
      <span class="num">Alpha · Android</span>
      <h3><a href="/apps/matcalc.html">MatCalc</a></h3>
      <p class="tagline"><em>Calculate material coverage, conversions, and turf installation needs.</em></p>
      <p>Fast offline calculator for landscapers, contractors, and DIYers. Coverage across 15 shapes, 12 preloaded materials, tonnage and cubic-yard estimates with settling adjustment.</p>
      <div class="editions">
        <a class="edition-btn ghost" href="/apps/matcalc.html">Details &rsaquo;</a>
      </div>
    </div>
  </article>

  <article class="app-card">
    <div class="app-card-icon">
      <img src="/images/apps/simmer.png" width="512" height="512" loading="lazy" decoding="async" alt="Simmer app icon — local recipe manager with AI-powered imports">
    </div>
    <div class="app-card-body">
      <span class="num">Alpha · Android</span>
      <h3><a href="/apps/simmer.html">Simmer</a></h3>
      <p class="tagline"><em>Collect, modify, and shop from your recipes with AI-powered imports.</em></p>
      <p>Personal recipe manager — no account, no cloud, fully local. Import from URL, photo, or manual entry; AI extraction via your own OpenAI, Gemini, or Claude API key.</p>
      <div class="editions">
        <a class="edition-btn ghost" href="/apps/simmer.html">Details &rsaquo;</a>
      </div>
    </div>
  </article>

  <div class="section-foot">
    <a class="link-arrow" href="/apps/">All apps &rsaquo;</a>
  </div>
</section>

<section id="about">
  <div class="kicker">№ 03 · The Maker</div>
  <h2>One person, <em>two crafts</em>.</h2>
  <div class="essay">
    <p>I'm Riley — I write under <strong>Riley E. Antrobus</strong> and publish software under <strong>Ink &amp; Iron Apps</strong>. Same workshop, two outputs: stories that take their time, and tools that don't waste yours.</p>
    <p class="pull">"Crafted stories. Forged software."</p>
    <p>The books and the apps live on the same site because they come from the same hands — but they don't share pages, and they aren't sold next to each other. A novel isn't a product line, and an app isn't a chapter.</p>
    <p>Reach the workshop at <a href="mailto:info@inknironapps.com">info@inknironapps.com</a>. Reach Riley directly at <a href="mailto:riley@inknironapps.com">riley@inknironapps.com</a>, or find him on <a href="https://www.facebook.com/people/Riley-E-Antrobus/61580037872318/" rel="noopener">Facebook</a>, <a href="https://www.goodreads.com/author/show/58136422.Riley_E_Antrobus" rel="noopener">Goodreads</a>, and his <a href="https://www.amazon.com/author/rileyeantrobus" rel="noopener">Amazon author page</a>.</p>
  </div>
</section>
</Base>
