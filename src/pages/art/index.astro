---
/**
 * Redbubble print shop.
 *
 * The grid is rendered client-side by Redbubble's own external_portfolio.js
 * widget — it draws an <iframe> of the live portfolio, so nothing here has to
 * be re-published when a new design goes up on Redbubble. Both scripts carry
 * `is:inline`: Astro would otherwise bundle them as modules, and the widget
 * relies on running inline, in order, at parse time.
 *
 * The widget is third-party and can fail (blocked script, no JS, Redbubble
 * down). The shop links below it are plain markup and always render, so the
 * page is never empty.
 */
import Base from "../../layouts/Base.astro";

const SHOP = "https://lightwraith8268.redbubble.com";

const head = {
  "title": "Art & Prints — Riley E. Antrobus",
  "description": "The Redbubble print shop of Riley E. Antrobus — designs on prints, stickers, apparel, and homeware, printed and shipped by Redbubble.",
  "keywords": "Riley E. Antrobus art, LightWraith8268, Redbubble shop, art prints, stickers, apparel, wall art, Ink and Iron Apps",
  "path": "/art/",
  "ogType": "website",
  "ogSiteName": "Riley E. Antrobus",
  "ogTitle": "Art & Prints — Riley E. Antrobus",
  "ogDescription": "Designs on prints, stickers, apparel, and homeware — printed and shipped by Redbubble.",
  "image": "/og-image-1200x630.png",
  "imageWidth": 1200,
  "imageHeight": 630,
  "preconnect": ["https://www.redbubble.com"],
  "jsonld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://inknironapps.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Art",
          "item": "https://inknironapps.com/art/"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Art & Prints by Riley E. Antrobus",
      "url": "https://inknironapps.com/art/",
      "description": "Redbubble print shop — designs on prints, stickers, apparel, and homeware.",
      "author": {
        "@type": "Person",
        "name": "Riley E. Antrobus",
        "url": "https://inknironapps.com/"
      },
      "mainEntity": {
        "@type": "WebPage",
        "name": "LightWraith8268 on Redbubble",
        "url": SHOP
      }
    }
  ]
};
---
<Base {...head}>
<section class="books-index">
  <a class="back-link" href="/">&larr; Home</a>
  <div class="kicker">The Print Shop</div>
  <h2>Art, <em>on things you can hold</em>.</h2>
  <p class="lede">Designs from the same workshop as the books and the apps, printed on demand by <strong>Redbubble</strong> — wall art, stickers, apparel, cases, and homeware. Printing, shipping and returns are all handled by Redbubble; nothing is sold on this site.</p>

  <div class="rb-portfolio">
    <script type="text/javascript" src="https://www.redbubble.com/assets/external_portfolio.js" is:inline></script>
    <script id="rb-xzfcxvzx" type="text/javascript" is:inline>new RBExternalPortfolio('www.redbubble.com', 'lightwraith8268', 2, 2).renderIframe();</script>
    <noscript>
      <p class="rb-fallback">The live gallery needs JavaScript. <a href={SHOP} rel="noopener">Browse the full shop on Redbubble &rarr;</a></p>
    </noscript>
  </div>

  <div class="editions">
    <a class="edition-btn primary" href={SHOP} rel="noopener">Open the shop &rarr;</a>
    <a class="edition-btn ghost" href="/contact.html?topic=general">Ask about a design &rsaquo;</a>
  </div>
</section>

<style is:global>
.rb-portfolio { margin: 36px 0 32px; min-height: 120px; }
.rb-portfolio iframe { max-width: 100%; border: 0; display: block; }
.rb-portfolio .rb-fallback { color: var(--muted); font-size: 17px; }
.rb-portfolio .rb-fallback a { color: var(--teal-bright); border-bottom: 1px solid rgba(59, 179, 201, 0.3); }
.rb-portfolio .rb-fallback a:hover { border-bottom-color: var(--teal-bright); }
</style>
</Base>
